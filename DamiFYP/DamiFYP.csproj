        <PackageReference Include="Serilog.Sinks.Seq" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DamiFYP.Application\DamiFYP.Application.csproj" />
      <ProjectReference Include="..\DamiFYP.Common\DamiFYP.Common.csproj" />
      <ProjectReference Include="..\DamiFYP.Domain\DamiFYP.Domain.csproj" />
